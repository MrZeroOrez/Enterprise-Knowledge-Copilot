# ==============================================================================
# Enterprise Knowledge Copilot - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named '.env':
#    Windows PowerShell: Copy-Item .env.example .env
# 2. Replace placeholder values with your real configuration.
# 3. NEVER commit your actual '.env' file or API keys to Git.
# ==============================================================================

# Google Gemini API Configuration (Required for Phase 3 and later)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Names (Configurable to prevent hardcoding model names in application code)
# If a model becomes deprecated or unavailable, change it here.
# Supported chat models: gemini-2.5-flash, gemini-2.0-flash
# Supported embedding models: gemini-embedding-001, gemini-embedding-2
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Document Chunking Settings (Phase 1 & 2)
# CHUNK_SIZE: Maximum number of characters in each chunk
CHUNK_SIZE=1000
# CHUNK_OVERLAP: Number of overlapping characters between consecutive chunks
# Rule: CHUNK_OVERLAP must be strictly less than CHUNK_SIZE and non-negative
CHUNK_OVERLAP=200

# Document Upload Settings (Phase 2)
# Maximum allowed size for uploaded PDF files in megabytes
MAX_UPLOAD_SIZE_MB=10

# Vector Database Settings (Phase 3)
# Storage path and collection name for local ChromaDB persistence
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIRECTORY=data/chromadb
CHROMA_COLLECTION_NAME=enterprise_documents

# Retrieval Settings (Phase 4)
# Default number of chunks to retrieve for a query
RETRIEVAL_TOP_K=5
# Maximum allowed top_k to prevent oversized queries
RETRIEVAL_MAX_TOP_K=50
# Optional maximum cosine distance threshold (0.0 to 2.0). Chunks with distance > threshold are filtered.
# Leave blank to disable filtering by default and return all top_k results.
RETRIEVAL_DISTANCE_THRESHOLD=

# RAG Generation & Context Budget Settings (Phase 5)
# Maximum total character length of retrieved chunks included in LLM context
RAG_MAX_CONTEXT_CHARS=20000
# Optional override for RAG retrieval count (defaults to RETRIEVAL_TOP_K if unset)
RAG_TOP_K=5
