# ==============================================================================
# Enterprise Knowledge Copilot - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named '.env':
#    Windows PowerShell: Copy-Item .env.example .env
# 2. Replace placeholder values with your real configuration.
# 3. NEVER commit your actual '.env' file or API keys to Git.
# ==============================================================================

# Google Gemini API Configuration (Required for Phase 3 and later)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Names (Configurable to prevent hardcoding model names in application code)
# If a model becomes deprecated or unavailable, change it here.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Document Chunking Settings (Phase 1)
# CHUNK_SIZE: Maximum number of characters in each chunk
CHUNK_SIZE=1000
# CHUNK_OVERLAP: Number of overlapping characters between consecutive chunks
# Rule: CHUNK_OVERLAP must be strictly less than CHUNK_SIZE and non-negative
CHUNK_OVERLAP=200

# Document Upload Settings (Phase 2)
# Maximum allowed size for uploaded PDF files in megabytes
MAX_UPLOAD_SIZE_MB=10

# Storage Paths
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIRECTORY=data/chromadb
